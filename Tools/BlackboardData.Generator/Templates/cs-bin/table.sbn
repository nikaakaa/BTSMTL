using Luban;
using ThirdPersonSimulation;
{{ bean = __table.value_ttype.def_bean }}
{{ domain = get_tag bean "btsmtl.domain" }}
{{ value_type = "ThirdPersonSimulation.AbilityStateValue" }}
{{ if domain == "FPGameplay"; value_type = "ThirdPersonSimulation.FPGameplay.AbilityStateValue"; end }}
namespace {{__namespace_with_top_module}}
{
    public sealed class {{bean.name}}Contract : GeneratedBlackboardContract<{{value_type}}>
    {
        public {{bean.name}}Contract() : base({{get_tag bean "btsmtl.owner"}}, {{get_tag bean "btsmtl.identity"}},
            {{get_tag bean "btsmtl.dataFile"}}, new GeneratedBlackboardField[]
            {
                {{~for field in bean.export_fields~}}
                new GeneratedBlackboardField({{get_tag field "btsmtl.id"}}, {{get_tag field "btsmtl.key"}},
                    {{get_tag field "btsmtl.index"}}, ProgramStateValueKind.{{get_tag field "btsmtl.kind"}},
                    ProgramScopeKind.{{get_tag field "btsmtl.scope"}}, ProgramBlackboardLifetime.{{get_tag field "btsmtl.lifetime"}}),
                {{~end~}}
            }) { }

        public override IGeneratedBlackboardValues<{{value_type}}> Create() => new {{bean.full_name}}();

        public override IGeneratedBlackboardValues<{{value_type}}> ReadDefaults(byte[] bytes)
        {
            var buffer = new ByteBuf(bytes);
            if (buffer.ReadSize() != 1)
                throw new System.IO.InvalidDataException("黑板默认配置必须包含一条记录。");
            var values = new {{bean.full_name}}();
            values.ReadDefaults(buffer);
            return values;
        }
    }
}
