<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ThirdPersonGameplay.Movement.MemoryPack</AssemblyName>
    <RootNamespace>ThirdPersonSimulation.Serialization</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ThirdPerson.Shared.Contracts/ThirdPerson.Shared.Contracts.csproj" />
    <ProjectReference Include="../ThirdPersonGameplay.Movement/ThirdPersonGameplay.Movement.csproj" />
    <ProjectReference Include="../ThirdPersonSimulation.Timeline/ThirdPersonSimulation.Timeline.csproj" />
    <ProjectReference Include="../ThirdPersonSimulation.MemoryPack/ThirdPersonSimulation.MemoryPack.csproj" />
    <ProjectReference Include="../../Tools/MemoryPackAdapter.Generator/MemoryPackAdapter.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Reference Include="MemoryPack.Core" HintPath="$(MemoryPackCorePath)" Private="false" />
    <Compile Include="../../Packages/com.thirdperson.gameplay/Runtime/MovementSerialization/*.cs" />
  </ItemGroup>
  <Target Name="RequireMemoryPack" BeforeTargets="ResolveReferences" Condition="!Exists('$(MemoryPackCorePath)')">
    <Error Text="请通过 MemoryPackCorePath 指定宿主现有的 MemoryPack.Core.dll。" />
  </Target>
</Project>
