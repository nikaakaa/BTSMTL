<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ThirdPerson.BepuQueries</AssemblyName>
    <QuerySourceRoot>$(MSBuildThisFileDirectory)..\..\Packages\com.thirdperson.gameplay\Runtime\Physics\BepuQueries</QuerySourceRoot>
    <QuantumDeterministicAssembly>$(MSBuildThisFileDirectory)..\..\..\3C\3cDemo\Client\3C_Client\Assets\Photon\Quantum\Assemblies\Quantum.Deterministic.dll</QuantumDeterministicAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(QuerySourceRoot)\**\*.cs" LinkBase="Source" />
