<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>BTSMTL.Authoring</AssemblyName>
    <DefineConstants>$(DefineConstants);BTSMTL_AUTHORING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <ProjectReference Include="../BTSMTL.Orchestration.Contracts/BTSMTL.Orchestration.Contracts.csproj" />
    <ProjectReference Include="../ThirdPersonSimulation.Timeline/ThirdPersonSimulation.Timeline.csproj" />
    <Compile Include="../../Packages/com.btsmtl/Authoring/BtsmtlRuntimeEditableAttribute.cs" />
    <Compile Include="../../Packages/com.btsmtl/Authoring/Timeline/*.cs" />
    <!-- Authoring/Graph 与 Blackboard 整目录为引擎外共享作者合同；只排除依赖 UnityEngine 的文件。 -->
    <Compile Include="../../Packages/com.btsmtl/Authoring/Graph/*.cs" Exclude="../../Packages/com.btsmtl/Authoring/Graph/*.Unity.cs;../../Packages/com.btsmtl/Authoring/Graph/DomainContracts.cs" />
    <Compile Include="../../Packages/com.btsmtl/Graphs/Authoring/BtsmtlFlowNodes.cs" />
    <Compile Include="../../Packages/com.btsmtl/Graphs/Authoring/BtsmtlCompositeFlowNodeConfiguration.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/*SerializedFields.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Tree/*SerializedFields.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/TimelineData.Content.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/TimelineData.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/ITimelineAuthoringDocument.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/ManagedReferenceCloneUtility.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/TimelineJson.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/TimelineData.Runtime.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Timeline.Marker.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Timeline.Sampling.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Timeline.CurveAuthoring.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Timeline.Contracts.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Timeline.ScenePresentation.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/TimelineContentClosure.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/TimelineGraphBindings.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/TimelineAuthoringFingerprint.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Timeline.AuthoringExtensions.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Scripts/Tree/Timeline.Tree.cs" />
    <Compile Include="../../Packages/com.btsmtl/Timeline/Editor/Scripts/*SerializedFields.cs" />
    <Compile Include="../../Packages/com.btsmtl/Authoring/Blackboard/*.cs" Exclude="../../Packages/com.btsmtl/Authoring/Blackboard/PipelineBlackboardVariableReference.cs" />
  </ItemGroup>
</Project>
