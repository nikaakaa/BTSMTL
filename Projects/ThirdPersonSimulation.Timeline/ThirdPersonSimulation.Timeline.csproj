<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>BTSMTL.Timeline.Runtime</AssemblyName>
    <TimelineSourceRoot>$(MSBuildThisFileDirectory)..\..\Packages\com.btsmtl\Timeline\Runtime</TimelineSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ThirdPersonSimulation.Timeline.Tests" />
    <ProjectReference Include="..\ThirdPerson.Shared.Contracts\ThirdPerson.Shared.Contracts.csproj" />
    <ProjectReference Include="..\BTSMTL.Orchestration.Contracts\BTSMTL.Orchestration.Contracts.csproj" />
    <ProjectReference Include="..\BTSMTL.Orchestration.Runtime\BTSMTL.Orchestration.Runtime.csproj" />
    <Compile Include="$(TimelineSourceRoot)\**\*.cs" LinkBase="Source" />
  </ItemGroup>
</Project>
