<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ThirdPersonSimulation.Timeline</AssemblyName>
    <TimelineSourceRoot>$(MSBuildThisFileDirectory)..\..\Packages\com.btsmtl\Timeline\Runtime</TimelineSourceRoot>
    <QuantumDeterministicPath>$(MSBuildThisFileDirectory)..\..\..\3C\3cDemo\Client\3C_Client\Assets\Photon\Quantum\Assemblies\Quantum.Deterministic.dll</QuantumDeterministicPath>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ThirdPersonSimulation.Timeline.Tests" />
    <ProjectReference Include="..\BTSMTL.Orchestration.Contracts\BTSMTL.Orchestration.Contracts.csproj" />
    <ProjectReference Include="..\ThirdPersonSimulation.Core\ThirdPersonSimulation.Core.csproj" />
    <ProjectReference Include="..\ThirdPersonSimulation.QuantumNumerics\ThirdPersonSimulation.QuantumNumerics.csproj" AdditionalProperties="QuantumDeterministicPath=$(QuantumDeterministicPath)" />
    <ProjectReference Include="..\ThirdPersonSimulation.Float32\ThirdPersonSimulation.Float32.csproj" />
    <Reference Include="Quantum.Deterministic">
      <HintPath>$(QuantumDeterministicPath)</HintPath>
    </Reference>
    <Compile Include="$(TimelineSourceRoot)\**\*.cs" LinkBase="Source" />
  </ItemGroup>
</Project>
