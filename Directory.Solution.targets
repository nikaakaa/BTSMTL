<Project>
  <Target Name="DependencyGuard" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Tools/DependencyGuard/DependencyGuard.csproj"
             Targets="Restore;Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);UseSharedCompilation=false;InstallUnityAnalyzer=false" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)Tools/DependencyGuard/DependencyGuard.csproj"
             Targets="GetTargetPath" BuildInParallel="false"
             Properties="Configuration=$(Configuration);UseSharedCompilation=false;InstallUnityAnalyzer=false">
      <Output TaskParameter="TargetOutputs" ItemName="DependencyGuardTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <DependencyGuardArguments>--sdk-root &quot;$(MSBuildThisFileDirectory).&quot;</DependencyGuardArguments>
      <DependencyGuardArguments Condition="'$(DependencyGuardClientRoot)' != ''">$(DependencyGuardArguments) --client-root &quot;$(DependencyGuardClientRoot)&quot;</DependencyGuardArguments>
      <DependencyGuardArguments Condition="'$(DependencyGuardReport)' != ''">$(DependencyGuardArguments) --report &quot;$(DependencyGuardReport)&quot;</DependencyGuardArguments>
    </PropertyGroup>
    <Exec Command="dotnet &quot;@(DependencyGuardTargetPath)&quot; $(DependencyGuardArguments)" />
  </Target>
  <!-- 宿主提供 Unity 工程与 Editor 路径时执行 Burst 兼容检查（Float32 数值目标）。 -->
  <Target Name="BurstCheck" AfterTargets="Build" Condition="'$(BurstCheckClientRoot)' != ''">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Tools/BurstCheck/BTSMTL.BurstCheck.csproj"
             Targets="Restore;Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);UseSharedCompilation=false;BurstCheckClientRoot=$(BurstCheckClientRoot);UnityEditorDataPath=$(UnityEditorDataPath);BurstCheckOutput=$(BurstCheckOutput);BurstCheckTemp=$(BurstCheckTemp)" />
  </Target>
</Project>
